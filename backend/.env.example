# Application
PROJECT_NAME="Agentic Data Automation"
ENVIRONMENT="development"          # development | staging | production
DEBUG=True
API_V1_STR="/api/v1"
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173"]'

# Database
DATABASE_URL="sqlite:///./agentic_ai.db"
# For PostgreSQL (docker compose): DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/agentic_ai"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Security & JWT
JWT_SECRET_KEY="CHANGE_ME"         # generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Secret encryption (Fernet); comma-separated for rotation, first key encrypts
ENCRYPTION_KEY="CHANGE_ME"         # generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Initial Admin (used only when the users table is empty; password >= 12 chars)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME"

# Airflow
AIRFLOW_ALLOWED_HOSTS='[]'         # e.g. '["airflow.internal", "localhost"]'; empty = allow all (dev only)
AIRFLOW_CONNECT_TIMEOUT_SECONDS=5
AIRFLOW_READ_TIMEOUT_SECONDS=10
# Background check that keeps connection status and the DAG list live
AIRFLOW_MONITOR_ENABLED=true
AIRFLOW_MONITOR_INTERVAL_SECONDS=30

# Database connections (catalog)
DB_CONNECTION_ALLOWED_HOSTS=[]
DB_CONNECT_TIMEOUT_SECONDS=5

# Detection
DETECTION_ENABLED=True
DETECTION_INTERVAL_SECONDS=120
DETECTION_LOOKBACK_HOURS=24
EVIDENCE_LOG_MAX_BYTES=65536
EVIDENCE_MAX_LOGS=3

# Automation
AUTOMATION_ENABLED=True
AUTOMATION_INTERVAL_SECONDS=30          # automation loop: advance waiting/pending runs
AUTOMATION_FORCE_DRY_RUN=False          # True = no workflow may change anything
AUTOMATION_MAX_ACTIONS_PER_DAG_PER_DAY=3
AUTOMATION_MAX_STEPS_PER_RUN=50
AUTOMATION_VERIFY_POLL_SECONDS=60
AUTOMATION_WEBHOOK_ALLOWED_HOSTS='[]'   # e.g. '["hooks.slack.com"]'; empty = allow all (dev only)
AUTOMATION_WEBHOOK_TIMEOUT_SECONDS=5
# Links in notifications point here (the frontend URL people use)
PUBLIC_APP_URL=http://localhost:5173
SMTP_TIMEOUT_SECONDS=10

# Local LLM for "Choose the fix" blocks set to suggest/decide (Ollama: `ollama pull qwen3:4b`).
# It only picks among the fixes the rules allow; disabled = the rules decide alone.
DECISION_LLM_ENABLED=False
DECISION_LLM_URL=http://127.0.0.1:11434
DECISION_LLM_MODEL=qwen3:4b
DECISION_LLM_TIMEOUT_SECONDS=60     # the first call loads the model (~30s)
DECISION_LLM_BREAKER_FAILURES=3
DECISION_LLM_BREAKER_COOLDOWN_SECONDS=120
